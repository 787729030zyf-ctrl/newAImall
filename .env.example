# Copy this file to .env.local and fill in your real server-side key.
# cp .env.example .env.local

# Used by both the Vercel serverless function and the local Vite middleware.
# Create a key at https://platform.stability.ai/keys
# Format: STABILITY_API_KEY=sk-...
# Restart npm run dev after changing this value.
STABILITY_API_KEY=

# Optional text large-model provider for the cosmetic recommendation assistant.
# Pick one provider:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Or Alibaba DashScope OpenAI-compatible mode:
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus

# Or DeepSeek:
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Or any OpenAI-compatible endpoint:
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
